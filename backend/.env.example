# TrustLine Environment Variables Example

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Nokia Network-as-Code (NaC) API Keys
NOKIA_NAC_API_KEY=your_nokia_nac_api_key_here
NOKIA_NAC_CLIENT_ID=your_nokia_client_id_here
NOKIA_NAC_CLIENT_SECRET=your_nokia_client_secret_here

# OAuth Redirect URI
REDIRECT_URI=http://localhost:8000/auth/number-verification/callback
